# copy this file to .env and fill in real values. .env is ignored by git,
# so your secrets never get committed.
#
# generate strong random values with:
#   openssl rand -hex 32     (for SALE_TOKEN_SECRET)
#   openssl rand -hex 16     (for RABBITMQ_PASSWORD)

# signs the sale tokens. must be at least 32 characters, or the api refuses to start.
SALE_TOKEN_SECRET=

# password for the rabbitmq user "flash" (also used by the api and workers)
RABBITMQ_PASSWORD=

# only for the local cdn simulation (docker-compose.cdn.yml). 8+ characters.
#   openssl rand -hex 16
MINIO_ROOT_PASSWORD=